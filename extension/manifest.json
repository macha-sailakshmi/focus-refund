{
  "manifest_version": 3,
  "name": "FocusRefund - The Muscle",
  "version": "1.0.0",
  "description": "Blocks distracting websites unless you spend 50 Focus Coins for 10min access",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.youtube.com/*",
    "*://*.reddit.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.youtube.com/*",
        "*://*.reddit.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusRefund"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [{
    "resources": ["dashboard/*"],
    "matches": ["<all_urls>"]
  }]
}
